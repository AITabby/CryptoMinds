# CryptoMinds 生产环境配置模板
# 复制为 .env.prod 后填入真实值：
#   cp environments/.env.prod.template environments/.env.prod
#
# 生成 secret:
#   openssl rand -hex 32

CRYPTOMINDS_ENV=prod
CRYPTOMINDS_DEBUG=false
CRYPTOMINDS_LOG_LEVEL=WARNING
CRYPTOMINDS_LOG_JSON=true
CRYPTOMINDS_INTERNAL_TOKEN=<openssl rand -hex 32>
CRYPTOMINDS_API_PORT=3458
DEMO_MODE=false

BSC_RPC=https://bsc-dataseed1.binance.org/
ESCROW_CONTRACT_ADDRESS=
ESCROW_V2_CONTRACT_ADDRESS=
ADMIN_SECRET=<openssl rand -hex 32>
ADMIN_PRIVATE_KEY=
ARBITER_WALLETS=
WATCHDOG_INTERVAL=60

# ── Wallet keys (env var 优先于 wallets.json) ──
