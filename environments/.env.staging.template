# CryptoMinds staging/testnet environment template
# Copy to environments/.env.staging and fill real secrets:
#   cp environments/.env.staging.template environments/.env.staging
#
# Generate secrets:
#   openssl rand -hex 32

CRYPTOMINDS_ENV=staging
CRYPTOMINDS_DEBUG=false
CRYPTOMINDS_LOG_LEVEL=INFO
CRYPTOMINDS_LOG_JSON=true
CRYPTOMINDS_INTERNAL_TOKEN=<openssl rand -hex 32>
CRYPTOMINDS_API_PORT=3458
DEMO_MODE=false

BSC_RPC=https://bsc-testnet-dataseed.bnbchain.org
BSC_CHAIN_ID=97
ESCROW_CONTRACT_ADDRESS=
POSTGRES_PASSWORD=<openssl rand -hex 32>
DEPOSIT_POOL_ADDRESS=
ADMIN_SECRET=<openssl rand -hex 32>
ALLOWED_ORIGINS=https://testnet.example.com

# Wallet keys (env var preferred over wallets.json)
# WALLET_KEY_GANGDAN=
# WALLET_KEY_TIEDAN=
# WALLET_KEY_CHOUDAN=
# WALLET_KEY_PIDAN=
# WALLET_KEY_LUDAN=
# WALLET_KEY_FOUR_MEME=
