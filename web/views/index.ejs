            <input id="regLatency" type="text" placeholder="如：~5秒" style="width:100%; background:#0f121e; border:1px solid rgba(100,116,139,0.25); border-radius:8px; padding:10px 12px; color:#e2e8f0; font-size:14px; outline:none; box-sizing:border-box;" onfocus="this.style.borderColor='rgba(139,92,246,0.5)'" onblur="this.style.borderColor='rgba(100,116,139,0.25)'">
          </div>
          <label style="display:block; color:#94a3b8; font-size:12px; margin-bottom:6px;" data-i18n="regModalPrice">定价（BNB）</label>
          <input id="regPrice" type="number" step="0.0001" placeholder="0.0002" style="width:100%; background:#0f121e; border:1px solid rgba(100,116,139,0.25); border-radius:8px; padding:10px 12px; color:#e2e8f0; font-size:14px; outline:none; box-sizing:border-box;" onfocus="this.style.borderColor='rgba(139,92,246,0.5)'" onblur="this.style.borderColor='rgba(100,116,139,0.25)'" oninput="validateRegisterForm()">
        </div>

        <!-- 交付方式：托管上传 vs 自托管 API -->
        <div style="background:#0f121e; border:1px solid rgba(139,92,246,0.15); border-radius:10px; padding:16px;">
          <div style="color:#a78bfa; font-size:13px; font-weight:600; margin-bottom:8px;"><i data-lucide="server" class="icon-inline"></i> 交付方式 <span style="color:#ef4444;">*</span></div>
          <div style="color:#64748b; font-size:11px; margin-bottom:12px;">选择平台替你执行代码，还是你自己提供 API 接口</div>
          <div style="display:flex; gap:8px; margin-bottom:12px;">
            <button type="button" id="deliveryModeHosted" onclick="setDeliveryMode('hosted')" style="flex:1; padding:10px 12px; border-radius:8px; border:2px solid rgba(139,92,246,0.6); background:rgba(139,92,246,0.15); color:#a78bfa; font-size:13px; font-weight:600; cursor:pointer; transition:all 0.2s;">
              📦 上传代码
              <div style="font-size:10px; font-weight:400; color:#94a3b8; margin-top:2px;">平台沙箱执行，无需服务器</div>
            </button>
            <button type="button" id="deliveryModeSelf" onclick="setDeliveryMode('self_hosted')" style="flex:1; padding:10px 12px; border-radius:8px; border:2px solid rgba(100,116,139,0.25); background:transparent; color:#94a3b8; font-size:13px; font-weight:600; cursor:pointer; transition:all 0.2s;">
