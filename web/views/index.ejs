    async function scanSkillFile(file) {
      const area = document.getElementById('scanResultArea');
      area.style.display = 'block';
      area.style.background = 'rgba(251,191,36,0.1)';
      area.style.border = '1px solid rgba(251,191,36,0.3)';
      area.style.color = '#fbbf24';
      area.textContent = '🔍 正在安全扫描...';
      try {
        const fd = new FormData();
        fd.append('skillFile', file);
        const res = await fetch('/api/skills/scan', { method: 'POST', body: fd });
        const data = await res.json();
        if (!data.ok) { area.style.background = 'rgba(248,113,113,0.1)'; area.style.border = '1px solid rgba(248,113,113,0.3)'; area.style.color = '#f87171'; area.textContent = '❌ 扫描失败: ' + (data.error || '未知错误'); return; }
        const scan = data.scan;
        if (scan.level === 'safe') {
          area.style.background = 'rgba(52,211,153,0.1)'; area.style.border = '1px solid rgba(52,211,153,0.3)'; area.style.color = '#34d399'; area.textContent = '✅ 安全扫描通过 (评分 ' + scan.score + '/100)';
        } else {
          area.style.background = 'rgba(248,113,113,0.1)'; area.style.border = '1px solid rgba(248,113,113,0.3)'; area.style.color = '#f87171'; area.innerHTML = '❌ 安全扫描未通过 (评分 ' + scan.score + '/100)<br>' + scan.issues.map(i => '• ' + i.category + ': ' + i.snippet).join('<br>');
        }
      } catch(e) {
        area.style.background = 'rgba(248,113,113,0.1)'; area.style.border = '1px solid rgba(248,113,113,0.3)'; area.style.color = '#f87171'; area.textContent = '❌ 扫描请求失败: ' + e.message;
      }
      validateRegisterForm();
    }

    function validateRegisterForm() {
      const expert = document.getElementById('regExpert').value.trim();
      const name = document.getElementById('regName').value.trim();
      const priceVal = document.getElementById('regPrice').value.trim();
      const priceNum = parseFloat(priceVal);
      const inputFormat = document.getElementById('regInputFormat').value.trim();
      const outputFormat = document.getElementById('regOutputFormat').value.trim();
      const wallet = document.getElementById('regWallet').value.trim() || currentAccount;
      const deliveryMode = document.getElementById('regDeliveryMode').value;
      const skillFile = document.getElementById('regSkillFile').files[0];
      const endpoint = document.getElementById('regEndpoint') ? document.getElementById('regEndpoint').value.trim() : '';

      // 检查扫描结果
      const scanArea = document.getElementById('scanResultArea');
      const scanBlocked = scanArea && scanArea.style.display !== 'none' && scanArea.textContent.includes('未通过');

      let deliveryValid = false;
      if (deliveryMode === 'hosted') {
        deliveryValid = !!skillFile && !scanBlocked;
      } else {
        deliveryValid = !!endpoint && endpoint.startsWith('http');
      }
      
      const valid = expert && name && priceVal && !isNaN(priceNum) && priceNum > 0 && inputFormat && outputFormat && wallet && deliveryValid;
      const depositBtn = document.getElementById('depositBtn');
      
      if (valid) {
        depositBtn.disabled = false;
        depositBtn.style.cursor = 'pointer';
        depositBtn.textContent = '提交入驻申请';
        depositBtn.style.background = 'linear-gradient(135deg,#8b5cf6,#6366f1)';
        depositBtn.style.color = '#fff';
        depositBtn.setAttribute('data-i18n', 'submitApplication');
      } else {
        depositBtn.disabled = true;
        depositBtn.style.cursor = 'not-allowed';
        depositBtn.style.background = 'linear-gradient(135deg,#475569,#334155)';
        depositBtn.style.color = '#94a3b8';
        if (!priceVal || isNaN(priceNum) || priceNum <= 0) {
          depositBtn.textContent = '请填写有效的价格';
        } else if (!deliveryValid) {
          depositBtn.textContent = deliveryMode === 'hosted' ? '请上传代码文件并确保通过安全扫描' : '请填写有效的 API Endpoint';
        } else {
          depositBtn.textContent = '请填写完整表单';
        }
        depositBtn.setAttribute('data-i18n', 'fillFormFirst');
      }
    }

    function identiconSvg(address, size = 40) {
      try {
        if (typeof Identicon !== 'undefined' && typeof Identicon === 'function') {
          return '<img src="data:image/png;base64,' + new Identicon(address.replace('0x',''), { size: size, format: 'png' }).toString() + '" style="width:' + size + 'px;height:' + size + 'px;border-radius:8px;">';
        }
      } catch(e) { /* SES or other extension blocks Identicon constructor */ }
