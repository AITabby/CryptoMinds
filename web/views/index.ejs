        console.error('connectWallet error:', e);
        if (e.code === 4001) {
          showError('已取消连接，请在 MetaMask 中点击"连接"');
        } else if (e.code === -32002) {
          showError('MetaMask 已有待处理的连接请求，请切换到 MetaMask 确认');
        } else {
          showError('连接失败：' + (e.message || '未知错误'));
        }
      }
    }

