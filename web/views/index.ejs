    // 缓存市场指标数据，切tab时可立即恢复
    let cachedMarketMetrics = null;

    function updateMetrics(transactions, services) {
      const now = Date.now();
      const h24 = 24 * 60 * 60 * 1000;

      // --- Agent 总数 (去重) ---
      const totalAgents = [...new Set((services || []).map(s => s.expert).filter(Boolean))].length;
      const metricAgentsEl = document.getElementById('metricAgents');
      if (metricAgentsEl) metricAgentsEl.textContent = totalAgents;
      const todayNew = (services || []).filter(s => {
        if (!s.registeredAt) return false;
        return (now - new Date(s.registeredAt).getTime()) < h24;
      }).length;
      const trendEl = document.getElementById('trendAgents');
      if (trendEl) {
        if (todayNew > 0) {
          trendEl.innerHTML = `<i data-lucide="trending-up" class="icon-inline"></i> 今日 +${todayNew}`;
          trendEl.className = 'trend up';
        } else {
          trendEl.textContent = '稳定运行中';
          trendEl.className = 'trend';
          trendEl.style.color = '#64748b';
        }
      }

      // --- 从真实购买订单计算 ---
      fetch('/api/purchases').then(r => r.json()).then(purchases => {
        const allOrders = purchases.filter(p => p.status === 'completed' || p.status === 'delivered' || p.status === 'demo-completed');

        // 24h 订单
        const recent24h = allOrders.filter(p => {
          const t = new Date(p.time).getTime();
          return !isNaN(t) && (now - t) < h24;
        });
        // 前24h 订单
        const prev24h = allOrders.filter(p => {
          const t = new Date(p.time).getTime();
          return !isNaN(t) && (now - t) >= h24 && (now - t) < 2 * h24;
        });

        // 24h 交易额
        const vol24h = recent24h.reduce((sum, p) => sum + (parseFloat(p.price) || 0), 0);
        const volPrev24h = prev24h.reduce((sum, p) => sum + (parseFloat(p.price) || 0), 0);
        const totalVol = allOrders.reduce((sum, p) => sum + (parseFloat(p.price) || 0), 0);

        // 缓存所有计算结果
        cachedMarketMetrics = { totalAgents, todayNew, vol24h, volPrev24h, recent24h: recent24h.length, prev24h: prev24h.length, totalVol, totalOrders: allOrders.length };

        // 只在市场 tab 写 DOM
        if (activeTab !== 'market') return;
        applyMarketMetrics();
      }).catch(() => {});
    }

    // 将缓存的市场指标应用到 DOM
    function applyMarketMetrics() {
      if (!cachedMarketMetrics) return;
      const m = cachedMarketMetrics;

      const metricAgentsEl = document.getElementById('metricAgents');
      if (metricAgentsEl) metricAgentsEl.textContent = m.totalAgents;
      const trendEl = document.getElementById('trendAgents');
      if (trendEl) {
        if (m.todayNew > 0) {
          trendEl.innerHTML = `<i data-lucide="trending-up" class="icon-inline"></i> 今日 +${m.todayNew}`;
          trendEl.className = 'trend up';
        } else {
          trendEl.textContent = '稳定运行中';
          trendEl.className = 'trend';
          trendEl.style.color = '#64748b';
        }
      }

      const _mv = document.getElementById('metricVolume'); if (_mv) _mv.textContent = m.vol24h > 0 ? m.vol24h.toFixed(4) + ' BNB' : '0 BNB';
      const trendVol = document.getElementById('trendVolume');
      let pctVol;
      if (m.volPrev24h > 0) {
        pctVol = ((m.vol24h - m.volPrev24h) / m.volPrev24h * 100).toFixed(1);
      } else {
        pctVol = m.vol24h > 0 ? null : '0';
      }
      if (trendVol) {
