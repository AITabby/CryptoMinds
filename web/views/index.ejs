                <div id="fileSelectedName"></div>
                <div style="font-size:11px; margin-top:4px; color:#64748b;">点击更换文件</div>
              </div>
            </div>
            <div id="scanResultArea" style="display:none; margin-top:10px; padding:10px; border-radius:8px; font-size:12px;"></div>
