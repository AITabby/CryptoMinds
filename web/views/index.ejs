	        } else if (isRealBNBDirectRoute(route)) {
	          showNotice(`<i data-lucide="loader" class="icon-inline spin"></i> 正在提交 BNB Escrow 担保支付，请在钱包中确认 ${route.chain.toUpperCase()} ${route.symbol} 转账...`);
	          data = await executeRealBNBDirectPayment(service, route, wallet);
	        } else {
	          renderProgressSteps('执行路径模拟中', `正在按 ${routeLabel} 模拟执行支付编排`, [
