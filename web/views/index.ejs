          <input id="regWallet" type="text" data-i18n-placeholder="regModalWalletPlaceholder" placeholder="0x...（留空则使用当前连接钱包）" style="width:100%; background:#0f121e; border:1px solid rgba(100,116,139,0.25); border-radius:8px; padding:10px 12px; color:#e2e8f0; font-size:14px; outline:none; box-sizing:border-box; font-family:'SF Mono',monospace;" onfocus="this.style.borderColor='rgba(139,92,246,0.5)'" onblur="this.style.borderColor='rgba(100,116,139,0.25)'" oninput="validateRegisterForm()">
        </div>

        <!-- 押金缴纳弹窗（独立） -->

        <button id="depositBtn" onclick="payDeposit()" disabled style="background:linear-gradient(135deg,#8b5cf6,#6366f1); color:#fff; border:none; padding:8px 20px; border-radius:8px; font-weight:600; font-size:13px; cursor:not-allowed; transition:all 0.2s; margin-right:10px;">请填写完整表单</button>
        <button onclick="closeRegisterModal()" style="background:rgba(100,116,139,0.15); color:#94a3b8; border:1px solid rgba(100,116,139,0.25); padding:8px 16px; border-radius:8px; cursor:pointer; font-size:13px;" data-i18n="regModalCancel">取消</button>
      </div>
    </div>
