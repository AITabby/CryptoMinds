	                  ${route.execution_preview?.steps ? `<div style="margin-top:8px; color:#94a3b8;">${route.execution_preview.steps.map((step, stepIndex) => `<div>${stepIndex + 1}. ${step}</div>`).join('')}</div>` : ''}
                  <div style="color:${isRealX402Route(route) || isRealSwapRoute(route) || isRealSplitRoute(route) ? '#34d399' : '#64748b'}; margin-top:6px; font-size:12px;">
                    ${isRealX402Route(route) ? '<i data-lucide="check-circle" class="icon-inline" style="color:#10b981"></i> x402 直接支付' : isRealSwapRoute(route) ? '<i data-lucide="check-circle" class="icon-inline" style="color:#10b981"></i> x402 / Swap 变体' : isRealSplitRoute(route) ? '<i data-lucide="check-circle" class="icon-inline" style="color:#10b981"></i> x402 / Split 变体' : isRealBNBDirectRoute(route) ? '<i data-lucide="shield" class="icon-inline" style="color:#10b981"></i> 🔒 BNB Escrow 担保支付' : '<i data-lucide="check-circle" class="icon-inline" style="color:#10b981"></i> 链上支付'}
                  </div>
