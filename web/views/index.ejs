      if (isPaymentInProgress) {
        showNotice('<i data-lucide="loader" class="icon-inline spin"></i> 上一笔支付正在处理中，请等待完成...');
        return;
      }
      isPaymentInProgress = true;

      const wallet = getActiveWallet();
      const buyerName = wallet.slice(0, 10) + '...';
      const routeLabel = `${route.route_type}/${route.chain}/${route.symbol}`;
      const service = getServiceById(serviceId);

      if (!service) {
        showError('服务信息缺失，请刷新页面后重试');
        isPaymentInProgress = false;
        return;
      }

	      try {
        let data;
        if (isRealSwapRoute(route)) {
          showNotice(`<i data-lucide="loader" class="icon-inline spin"></i> Swap 路由：先 BNB→USDC 兑换，再完成 x402 支付，请在钱包中确认两笔交易...`);
