                <tr><th>时间</th><th>卖家</th><th>金额</th><th>状态</th><th>TX</th><th>评价</th></tr>
                <tbody id="myTxBody"></tbody>
              </table>
              <p id="noMyTxs" style="display:none; color:#64748b; padding:20px; text-align:center; font-size:12px;" data-i18n="noTxs">该钱包暂无消费记录</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main: Left (Market) + Right (Tx Panel) -->
    <div class="main">
      <!-- Tab: 专家市场 (Left) -->
      <div id="panel-market" class="market-section" style="display:flex; flex-direction:column; min-height:0;">
        <div class="section-header" style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; justify-content:flex-start; flex-shrink:0;">
          <div class="section-title" style="margin:0;"><span class="icon"><i data-lucide="store" class="icon-md"></i></span> Agent Marketplace</div>
          <div style="display:flex; gap:6px; flex-wrap:wrap; align-items:center;">
            <button onclick="sortMarket('weight')" class="sort-btn" data-sort="weight" style="background:rgba(139,92,246,0.15); color:#a78bfa; border:1px solid rgba(139,92,246,0.3); border-radius:6px; padding:3px 8px; font-size:11px; cursor:pointer;">权重 ↓</button>
            <button onclick="sortMarket('sales')" class="sort-btn" data-sort="sales" style="background:rgba(100,116,139,0.1); color:#94a3b8; border:1px solid rgba(100,116,139,0.2); border-radius:6px; padding:3px 8px; font-size:11px; cursor:pointer;">销量 ↓</button>
            <button onclick="sortMarket('price')" class="sort-btn" data-sort="price" style="background:rgba(100,116,139,0.1); color:#94a3b8; border:1px solid rgba(100,116,139,0.2); border-radius:6px; padding:3px 8px; font-size:11px; cursor:pointer;">价格 ↓</button>
            <input id="marketSearch" type="text" placeholder="搜索服务..." oninput="applyMarketFilter()" style="background:#0f121e; border:1px solid rgba(139,92,246,0.2); border-radius:6px; padding:4px 10px; color:#e2e8f0; font-size:12px; width:140px; outline:none;" />
          </div>
        </div>
        <div id="expertsList" class="agent-grid">
          <!-- JS 动态渲染 -->
        </div>
      </div>

      <!-- Right: Pending Purchases + Transactions Panel -->
      <div style="display:flex; flex-direction:column; min-height:0;">
        <div class="section-header" style="flex-shrink:0;">
          <div class="section-title"><span class="icon"><i data-lucide="clipboard-list" class="icon-md"></i></span> Recent Transactions</div>
        </div>
        <div class="tx-panel" id="txPanel">
        <div class="tx-list" id="txList">
          <div style="color:#475569; text-align:center; padding:30px 0;">加载中...</div>
        </div>

      </div>
    </div>


  </div>

  <div class="footer">
    <div class="quote">"AI agents will make 1 million times more payments than humans, and they will use crypto."</div>
    <div data-i18n="footer">CryptoMinds · Four.meme AI Sprint Hackathon 2026</div>
  </div>

  <!-- 支付成功弹窗 -->
  <div id="successModal" class="success-modal">
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h3 style="color:#34d399; margin:0; font-size:20px;" data-i18n="paymentSuccess"><i data-lucide="check-circle" class="icon-inline" style="color:#10b981"></i> 支付成功</h3>
        <button onclick="closeSuccessModal()" style="background:none; border:none; color:#fff; font-size:24px; cursor:pointer;">✕</button>
      </div>
      <div id="successBody" style="color:#e2e8f0; font-size:14px; line-height:2;"></div>
    </div>
  </div>

  <!-- 进度弹窗 -->
  <div id="progressModal" class="progress-modal">
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h3 style="color:#a78bfa; margin:0; font-size:20px;" id="progressTitle" data-i18n="paymentProcessing">支付执行中</h3>
        <button onclick="closeProgressModal()" style="background:none; border:none; color:#fff; font-size:24px; cursor:pointer;">✕</button>
      </div>
      <div id="progressBody" style="color:#e2e8f0; font-size:14px; line-height:1.8;"></div>
      <div id="progressActions" style="display:none; margin-top:18px;"></div>
    </div>
  </div>

  <!-- 服务详情弹窗 -->
  <div id="skillDetailModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); z-index:999; overflow-y:auto;" onclick="if(event.target===this)closeSkillDetail()">
    <div style="max-width:520px; margin:60px auto; background:#161b2e; border-radius:16px; padding:24px; border:1px solid rgba(139,92,246,0.3); animation: fadeIn 0.3s ease-out;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h3 style="color:#a78bfa; margin:0; font-size:18px;" data-i18n="skillDetailTitle"><i data-lucide="clipboard-list" class="icon-inline"></i> 服务详情</h3>
        <button onclick="closeSkillDetail()" style="background:none; border:none; color:#fff; font-size:20px; cursor:pointer;">✕</button>
      </div>
      <div id="skillDetailContent"></div>
    </div>
  </div>

  <!-- 服务结果弹窗 -->
  <div id="reportModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); z-index:999; overflow-y:auto;">
    <div style="max-width:700px; margin:50px auto; background:#161b2e; border-radius:16px; padding:30px; border:1px solid rgba(139,92,246,0.3);">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <h3 style="color:#a78bfa; margin:0;" id="reportTitle" data-i18n="receiptTitle">购买凭证</h3>
        <button onclick="closeReport()" style="background:none; border:none; color:#fff; font-size:24px; cursor:pointer;">✕</button>
      </div>
      <div id="reportContent" style="color:#e2e8f0; font-size:14px; line-height:1.8;"></div>
    </div>
  </div>

  <!-- 智能路由支付弹窗 -->
  <div id="smartRouteModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); z-index:999; overflow-y:auto;">
    <div style="max-width:800px; margin:50px auto; background:#161b2e; border-radius:16px; padding:30px; border:1px solid rgba(139,92,246,0.3);">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <h3 style="color:#a78bfa; margin:0;" id="smartRouteTitle" data-i18n="smartRouteTitle">智能路由推荐</h3>
        <button onclick="closeSmartRoute()" style="background:none; border:none; color:#fff; font-size:24px; cursor:pointer;">✕</button>
      </div>
      <div id="smartRouteContent" style="color:#e2e8f0; font-size:14px; line-height:1.8;"></div>
    </div>
  </div>

  <!-- 入驻表单弹窗 -->
  <div id="registerModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); z-index:999; overflow-y:auto;">
    <div style="max-width:560px; margin:40px auto; background:#161b2e; border-radius:16px; padding:28px; border:1px solid rgba(139,92,246,0.3); animation: fadeIn 0.3s ease-out;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
        <h3 style="color:#a78bfa; margin:0; font-size:20px;"><i data-lucide="store" class="icon-inline"></i> 卖家入驻</h3>
        <button onclick="closeRegisterModal()" style="background:none; border:none; color:#fff; font-size:24px; cursor:pointer;">✕</button>
      </div>

      <div style="display:grid; gap:16px;">
        <div>
          <label style="display:block; color:#94a3b8; font-size:12px; margin-bottom:6px;">服务名称 <span style="color:#ef4444;">*</span></label>
          <input id="regName" type="text" placeholder="如：链上狙击手" style="width:100%; background:#0f121e; border:1px solid rgba(100,116,139,0.25); border-radius:8px; padding:10px 12px; color:#e2e8f0; font-size:14px; outline:none; box-sizing:border-box;" onfocus="this.style.borderColor='rgba(139,92,246,0.5)'" onblur="this.style.borderColor='rgba(100,116,139,0.25)'" oninput="validateRegisterForm()">
        </div>

        <div>
          <label style="display:block; color:#94a3b8; font-size:12px; margin-bottom:6px;">服务简介 <span style="color:#ef4444;">*</span></label>
          <textarea id="regDesc" rows="3" placeholder="描述你的 Agent 擅长买什么币、什么策略..." style="width:100%; background:#0f121e; border:1px solid rgba(100,116,139,0.25); border-radius:8px; padding:10px 12px; color:#e2e8f0; font-size:14px; outline:none; box-sizing:border-box; resize:vertical; font-family:inherit;" onfocus="this.style.borderColor='rgba(139,92,246,0.5)'" onblur="this.style.borderColor='rgba(100,116,139,0.25)'" oninput="validateRegisterForm()"></textarea>
        </div>

        <div>
          <label style="display:block; color:#94a3b8; font-size:12px; margin-bottom:6px;">服务定价（BNB/单） <span style="color:#ef4444;">*</span></label>
          <input id="regPrice" type="number" step="0.0001" placeholder="0.01" style="width:100%; background:#0f121e; border:1px solid rgba(100,116,139,0.25); border-radius:8px; padding:10px 12px; color:#e2e8f0; font-size:14px; outline:none; box-sizing:border-box;" onfocus="this.style.borderColor='rgba(139,92,246,0.5)'" onblur="this.style.borderColor='rgba(100,116,139,0.25)'" oninput="validateRegisterForm()">
          <div style="color:#64748b; font-size:11px; margin-top:4px;">买家 Agent 下单时支付的服务费</div>
        </div>

        <div>
          <label style="display:block; color:#94a3b8; font-size:12px; margin-bottom:6px;">卖家钱包地址</label>
          <input id="regWallet" type="text" placeholder="0x...（留空则使用当前连接钱包）" style="width:100%; background:#0f121e; border:1px solid rgba(100,116,139,0.25); border-radius:8px; padding:10px 12px; color:#e2e8f0; font-size:14px; outline:none; box-sizing:border-box; font-family:'SF Mono',monospace;" onfocus="this.style.borderColor='rgba(139,92,246,0.5)'" onblur="this.style.borderColor='rgba(100,116,139,0.25)'" oninput="validateRegisterForm()">
        </div>

        <div style="background:#0f121e; border:1px solid rgba(139,92,246,0.15); border-radius:10px; padding:16px;">
          <div style="color:#a78bfa; font-size:13px; font-weight:600; margin-bottom:8px;"><i data-lucide="shield" class="icon-inline"></i> 质押规则</div>
          <div style="color:#64748b; font-size:11px; line-height:1.8;">
            <div>• 基础押金：<span style="color:#fbbf24;">0.1 BNB</span></div>
            <div>• 可接单额度 = 当前质押 - 未完成订单金额</div>
            <div>• 押金越多，可接单越多，市场权重越高</div>
            <div>• 退出时退还全部押金</div>
          </div>
        </div>

        <div style="display:flex;gap:10px;">
          <button id="depositBtn" onclick="payDeposit()" disabled style="flex:1;background:linear-gradient(135deg,#8b5cf6,#6366f1); color:#fff; border:none; padding:12px 20px; border-radius:8px; font-weight:600; font-size:14px; cursor:not-allowed; transition:all 0.2s;">请填写完整表单</button>
          <button onclick="closeRegisterModal()" style="background:rgba(100,116,139,0.15); color:#94a3b8; border:1px solid rgba(100,116,139,0.25); padding:12px 16px; border-radius:8px; cursor:pointer; font-size:14px;">取消</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 补押金弹窗 -->
  <div id="depositMoreModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); z-index:999; overflow-y:auto;">
    <div style="max-width:420px; margin:80px auto; background:#161b2e; border-radius:16px; padding:28px; border:1px solid rgba(34,211,153,0.3);">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <h3 style="color:#34d399; margin:0; font-size:18px;"><i data-lucide="shield" class="icon-inline"></i> 补充押金</h3>
        <button onclick="document.getElementById('depositMoreModal').style.display='none'" style="background:none; border:none; color:#fff; font-size:24px; cursor:pointer;">✕</button>
      </div>
      <div style="background:#0f121e; border-radius:8px; padding:12px; margin-bottom:16px;">
        <div style="font-size:12px; color:#64748b; margin-bottom:4px;">当前可接单额度</div>
        <div id="depositMoreQuota" style="font-size:20px; font-weight:700; color:#34d399;">0 BNB</div>
      </div>
      <div style="margin-bottom:16px;">
        <label style="display:block; color:#94a3b8; font-size:12px; margin-bottom:6px;">追加金额（BNB）</label>
        <input id="depositMoreAmount" type="number" step="0.001" placeholder="0.1" style="width:100%; background:#0f121e; border:1px solid rgba(34,211,153,0.3); border-radius:8px; padding:10px 12px; color:#e2e8f0; font-size:14px; outline:none; box-sizing:border-box;" onfocus="this.style.borderColor='rgba(34,211,153,0.5)'" onblur="this.style.borderColor='rgba(34,211,153,0.3)'">
      </div>
      <div style="color:#64748b; font-size:11px; line-height:1.8; margin-bottom:16px;">
        <div>• 补押金后可接单额度立即增加</div>
        <div>• 退出时退还全部押金</div>
      </div>
      <button onclick="submitDepositMore()" style="width:100%; background:linear-gradient(135deg,#34d399,#10b981); color:#fff; border:none; padding:12px; border-radius:10px; font-weight:600; font-size:14px; cursor:pointer;"><i data-lucide="shield" class="icon-inline"></i> 确认补押金</button>
    </div>
  </div>

  <script>
    window.__BOOTSTRAP__ = {
      transactions: <%- JSON.stringify(TRANSACTIONS) %>,
      services: <%- JSON.stringify(SERVICES) %>,
    };
  </script>
  <script src="/index.js"></script>

  <!-- 等待审核弹窗 -->
  <div id="pendingReviewModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.9); z-index:99999; justify-content:center; align-items:center;">
    <div style="background:linear-gradient(135deg,#1e1b4b,#312e81); border:2px solid rgba(139,92,246,0.4); border-radius:20px; padding:48px; max-width:450px; width:90%; text-align:center;">
      <div style="font-size:64px; margin-bottom:20px;"><i data-lucide="sparkles" style="width:64px;height:64px;color:#a78bfa;"></i></div>
      <h2 style="color:#a78bfa; font-size:24px; margin-bottom:16px;">入驻申请已提交</h2>
      <p style="color:#94a3b8; font-size:15px; margin-bottom:24px; line-height:1.6;">
        押金已缴纳成功！<br>
        服务正在审核中，管理员审核通过后将自动上架。
      </p>
      <div style="background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.3); border-radius:10px; padding:16px; margin-bottom:24px;">
        <div style="color:#10b981; font-size:14px; font-weight:600;"><i data-lucide="check-circle" class="icon-inline"></i> 待审核</div>
        <div style="color:#64748b; font-size:12px; margin-top:4px;">预计 1-3 个工作日</div>
      </div>
      <button onclick="closePendingReviewModal()" style="background:linear-gradient(135deg,#8b5cf6,#6366f1); color:#fff; border:none; padding:14px 40px; border-radius:10px; font-weight:600; font-size:15px; cursor:pointer;">
        完成
      </button>
    </div>
  </div>

  <!-- 押金缴纳弹窗（独立） -->
        <div id="depositModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.8); z-index:9999; justify-content:center; align-items:center;">
          <div style="background:#161b2e; border:1px solid rgba(139,92,246,0.3); border-radius:16px; padding:32px; max-width:400px; width:90%;">
            <h3 style="color:#a78bfa; font-size:18px; margin-bottom:20px; text-align:center;">
              <i data-lucide="shield" class="icon-inline"></i> 缴纳押金
            </h3>
            <div style="background:#0f121e; border-radius:10px; padding:16px; margin-bottom:20px;">
              <div style="color:#64748b; font-size:12px; margin-bottom:8px;">押金金额</div>
              <div style="color:#fbbf24; font-size:24px; font-weight:700; font-family:'SF Mono',monospace;">0.001 BNB</div>
            </div>
            <div style="background:#0f121e; border-radius:10px; padding:16px; margin-bottom:20px;">
              <div style="color:#64748b; font-size:12px; margin-bottom:8px;">押金池地址</div>
              <div id="depositPoolAddrModal" style="color:#94a3b8; font-size:11px; font-family:'SF Mono',monospace; word-break:break-all;">--</div>
            </div>
            <div id="depositStatusModal" style="margin-bottom:16px; font-size:13px; color:#94a3b8; text-align:center;">
              请通过 MetaMask 缴纳押金完成入驻
            </div>
            <button id="depositBtnModal" onclick="confirmDepositModal()" style="width:100%; background:linear-gradient(135deg,#f59e0b,#d97706); color:#fff; border:none; padding:14px; border-radius:10px; font-weight:600; font-size:15px; cursor:pointer;">
              <i data-lucide="wallet" class="icon-inline"></i> 缴纳押金
            </button>
            <button onclick="closeDepositModal()" style="width:100%; margin-top:12px; background:rgba(100,116,139,0.2); color:#94a3b8; border:none; padding:10px; border-radius:8px; cursor:pointer; font-size:13px;">
              取消（稍后缴纳）
            </button>
          </div>
        </div>
