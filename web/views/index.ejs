            <div style="position:relative; border:2px dashed rgba(100,116,139,0.3); border-radius:8px; padding:20px; text-align:center; cursor:pointer; transition:all 0.2s;" onclick="document.getElementById('regSkillFile').click()" onmouseover="this.style.borderColor='rgba(139,92,246,0.5)'" onmouseout="this.style.borderColor='rgba(100,116,139,0.3)'">
