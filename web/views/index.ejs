	          }
	          const response = await fetch('/api/services/buy', {
	            method: 'POST',
	            headers: { 'Content-Type': 'application/json' },
	            body: JSON.stringify({
	              serviceId,
	              buyerWallet: wallet,
	              buyerName,
	              paymentMode: 'demo',
	              txHash: '',
	              selectedRoute: {
	                route_type: route.route_type,
	                chain: route.chain,
                symbol: route.symbol
              }
            })
          });
	          data = await response.json();
	        }

	        if (data.ok) {
	          closeProgressModal();
	          closeSmartRoute();
	          showSuccessModal('服务购买成功', {
	            service: data.purchase.serviceName,
	            expert: data.purchase.expert,
	            amount: `${data.purchase.price} ${data.purchase.priceCurrency || 'BNB'}`,
	            route: routeLabel,
	            chain: data.purchase.payment?.chain,
	            paymentMode: data.purchase.payment?.mode === 'demo' ? '演示模式' : (data.purchase.escrowAddress ? 'BNB Escrow 担保支付' : data.purchase.payment?.mode),
	            paymentStatus: data.purchase.payment?.verified ? '已验证链上支付' : (data.purchase.escrowAddress ? '资金已锁定在担保合约' : '链上支付待确认'),
	            txHash: data.purchase.txHash || data.purchase.payment?.txHash || '',
            txHint: data.purchase.escrowAddress ? '🔒 BNB 已锁定在 Escrow 合约，确认收货后释放给卖家' : (data.purchase.payment?.verified ? '' : '交易已提交，等待链上确认')
          });
	          if (document.getElementById('myAgent').style.display === 'block') {
	            autoLoadWalletData();
