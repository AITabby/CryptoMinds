    async function loadSellerStats() {
      const wallet = currentAccount || getActiveWallet();
      if (!wallet) return;
      try {
        const res = await fetch(`/api/seller-stats?wallet=${wallet}`);
        const data = await res.json();
        if (!data.ok) return;
        if (activeTab !== 'register') return; // tab 已切走，不写
        // 总收入 / 总订单
        const totalIncomeEl = document.getElementById('sellerTotalIncome');
        const totalOrdersEl = document.getElementById('sellerTotalOrders');
        if (totalIncomeEl) totalIncomeEl.textContent = data.income.toFixed(6) + ' BNB';
        if (totalOrdersEl) totalOrdersEl.textContent = data.completedOrders || 0;
        // 今日统计 + 涨跌幅
        const ordersRes = await fetch(`/api/received-orders?wallet=${currentAccount}`);
        const ordersData = await ordersRes.json();
        if (ordersData.ok) {
          const now = new Date();
          const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate());
          const yesterdayStart = new Date(todayStart - 86400000);
          const todayOrders = ordersData.orders.filter(o => new Date(o.time) >= todayStart);
          const yesterdayOrders = ordersData.orders.filter(o => {
            const t = new Date(o.time);
            return t >= yesterdayStart && t < todayStart;
          });
          const todayIncome = todayOrders.reduce((s, o) => s + (parseFloat(o.price) || 0), 0);
          const yesterdayIncome = yesterdayOrders.reduce((s, o) => s + (parseFloat(o.price) || 0), 0);
          // 今日收入
          const todayIncomeEl = document.getElementById('sellerTodayIncome');
          if (todayIncomeEl) todayIncomeEl.textContent = todayIncome.toFixed(6) + ' BNB';
          const incomeTrend = document.getElementById('sellerTodayIncomeTrend');
          if (incomeTrend) {
            if (yesterdayIncome > 0) {
              const pct = ((todayIncome - yesterdayIncome) / yesterdayIncome * 100).toFixed(1);
              incomeTrend.innerHTML = `<i data-lucide="${pct >= 0 ? 'trending-up' : 'trending-down'}" class="icon-inline"></i> ${pct >= 0 ? '+' : ''}${pct}%`;
              incomeTrend.className = 'trend ' + (pct >= 0 ? 'up' : 'down');
            } else {
              incomeTrend.innerHTML = todayIncome > 0 ? '<i data-lucide="trending-up" class="icon-inline"></i> 今日新增' : '&nbsp;';
              incomeTrend.className = todayIncome > 0 ? 'trend up' : 'trend';
            }
          }
          // 今日订单
          const todayOrdersEl = document.getElementById('sellerTodayOrders');
          if (todayOrdersEl) todayOrdersEl.textContent = todayOrders.length;
          const orderTrend = document.getElementById('sellerTodayOrdersTrend');
          if (orderTrend) {
            const orderDiff = todayOrders.length - yesterdayOrders.length;
            if (yesterdayOrders.length > 0) {
              const pct = (orderDiff / yesterdayOrders.length * 100).toFixed(1);
              orderTrend.innerHTML = `<i data-lucide="${pct >= 0 ? 'trending-up' : 'trending-down'}" class="icon-inline"></i> ${pct >= 0 ? '+' : ''}${pct}%`;
              orderTrend.className = 'trend ' + (pct >= 0 ? 'up' : 'down');
            } else {
              orderTrend.innerHTML = todayOrders.length > 0 ? `<i data-lucide="trending-up" class="icon-inline"></i> +${todayOrders.length}` : '&nbsp;';
              orderTrend.className = todayOrders.length > 0 ? 'trend up' : 'trend';
            }
          }
          // 总收入 trend
          const totalIncomeTrend = document.getElementById('sellerTotalIncomeTrend');
          if (totalIncomeTrend) {
            totalIncomeTrend.textContent = ordersData.orders.length + ' 笔';
            totalIncomeTrend.className = 'trend';
            totalIncomeTrend.style.color = '#64748b';
          }
          // 总订单 trend
          const totalOrderTrend = document.getElementById('sellerTotalOrdersTrend');
          if (totalOrderTrend) {
            totalOrderTrend.textContent = '累计交易';
            totalOrderTrend.className = 'trend';
            totalOrderTrend.style.color = '#64748b';
          }
        }
        lucide.createIcons();
      } catch(e) {}
    }

