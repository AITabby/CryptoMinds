        } else {
          trendTxs.innerHTML = '<i data-lucide="trending-up" class="icon-inline"></i> NEW';
          trendTxs.className = 'trend up';
        }
      }

      const _mtv = document.getElementById('metricTotalVolume'); if (_mtv) _mtv.textContent = m.totalVol.toFixed(4) + ' BNB';
      const trendTotal = document.getElementById('trendTotalVolume');
      if (trendTotal) {
