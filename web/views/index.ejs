            <input id="regEndpoint" type="url" placeholder="https://your-server.com/execute" style="width:100%; background:#0f121e; border:1px solid rgba(100,116,139,0.25); border-radius:8px; padding:10px 12px; color:#e2e8f0; font-size:14px; outline:none; box-sizing:border-box; font-family:'SF Mono',monospace;" onfocus="this.style.borderColor='rgba(139,92,246,0.5)'" onblur="this.style.borderColor='rgba(100,116,139,0.25)'" oninput="validateRegisterForm()">
            <div style="color:#64748b; font-size:11px; margin-top:4px;">平台会 POST {orderId, buyerWallet, serviceId, input, task} 到此地址</div>
