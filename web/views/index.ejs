async function payDeposit() {
  if (!currentAccount) { showError('请先连接钱包'); return; }
  
  const btn = document.getElementById('depositBtn');
  btn.disabled = true;
  btn.textContent = '提交申请中...';
  
  try {
    const expert = document.getElementById('regExpert').value.trim();
    const name = document.getElementById('regName').value.trim();
    const price = parseFloat(document.getElementById('regPrice').value) || 0.0001;
    const desc = document.getElementById('regDesc').value.trim();
    const wallet = document.getElementById('regWallet').value.trim() || currentAccount;
    const inputFormat = document.getElementById('regInputFormat').value.trim();
    const outputFormat = document.getElementById('regOutputFormat').value.trim();
    const latency = document.getElementById('regLatency').value.trim();
    const deliveryMode = document.getElementById('regDeliveryMode').value;
    const skillFile = document.getElementById('regSkillFile').files[0];
    const endpoint = document.getElementById('regEndpoint') ? document.getElementById('regEndpoint').value.trim() : '';
    
    const formData = new FormData();
    formData.append('expert', expert);
    formData.append('name', name);
    formData.append('desc', desc);
    formData.append('price', String(price));
    formData.append('wallet', wallet);
    formData.append('deposit', '0.001');
    formData.append('depositTx', '');
    formData.append('inputFormat', inputFormat);
    formData.append('outputFormat', outputFormat);
    formData.append('latency', latency);
    formData.append('status', 'pending_deposit');
    formData.append('deliveryMode', deliveryMode);
    if (deliveryMode === 'hosted' && skillFile) {
      formData.append('skillFile', skillFile);
    } else if (deliveryMode === 'self_hosted' && endpoint) {
      formData.append('endpoint', endpoint);
    }
    
    const res = await fetch('/api/experts/register', {
      method: 'POST',
      body: formData
    });
    const data = await res.json();
    
    if (!data.ok) {
      showError(data.error || '提交失败');
      btn.disabled = false;
      btn.textContent = '提交入驻申请';
      return;
    }
    
    pendingServiceId = data.serviceId;
    
    // 关闭入驻表单，打开押金弹窗
    closeRegisterModal();
    openDepositModal();
    
  } catch(e) {
    showError('提交失败: ' + e.message);
    btn.disabled = false;
    btn.textContent = '提交入驻申请';
  }
}

