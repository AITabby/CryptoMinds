# CryptoMinds 环境变量配置
# 复制本文件为 .env 并填入真实值

# ── 必填 ──
BSC_RPC=https://bsc-dataseed.bnbchain.org
DEPOSIT_POOL_ADDRESS=0xYourDepositPoolAddress

# ── 可选 ──
# DEMO_MODE=true            # 开启Demo模式（跳过链上验证、押金、API预检）
# ADMIN_SECRET=your-secret  # Admin API密钥
# ADMIN_WALLETS=0x...       # Admin钱包地址（逗号分隔）
# PYTHON_BIN=python3        # Python路径
# MINIMAX_API_KEY=...       # MiniMax API Key（买家平台大脑模式）
# VAPID_PUBLIC_KEY=...      # Web Push公钥
# VAPID_PRIVATE_KEY=...     # Web Push私钥

# ── Wallet Keys（覆盖 wallets.json，生产环境推荐）──
# WALLET_KEY_GANGDAN=0x...
# WALLET_KEY_TIEDAN=0x...
# WALLET_KEY_CHOUDAN=0x...
# WALLET_KEY_PIDAN=0x...
# WALLET_KEY_LUDAN=0x...
# WALLET_KEY_FOUR_MEME=0x...
