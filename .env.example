# CryptoMinds 环境变量配置
#
# 环境管理方式（推荐）:
#   1. 设置 CRYPTOMINDS_ENV=dev|staging|prod
#   2. 对应的 environments/.env.{env} 自动加载
#   3. 本文件(.env)作为本地默认值；environments/.env.* 会覆盖它
#
# 最简启动：复制本文件为 .env，什么都不改即可开发
#
# 环境模板见 environments/ 目录：
#   environments/.env.dev    — 开发（Demo模式、Debug日志）
#   environments/.env.staging.template — 预发布模板（BSC Testnet）
#   environments/.env.prod    — 生产（严格校验、JSON日志）

# ── 环境标识 ──
CRYPTOMINDS_ENV=dev

# ── 服务端口 ──
# CRYPTOMINDS_API_PORT=3458   # Flask API
# PORT=3457                    # Express Gateway

# ── 认证 ──
# CRYPTOMINDS_INTERNAL_TOKEN=dev-local-token   # Python API 内部认证
# ADMIN_SECRET=                                 # 管理员密钥 (争议仲裁、Escrow 创建)
# ADMIN_WALLETS=                                # 管理员钱包地址 (逗号分隔, 不推荐)

# ── 运行模式 ──
# DEMO_MODE=true        # 跳过链上验证、允许 DEMO 占位符私钥
# CRYPTOMINDS_DEBUG=true
# CRYPTOMINDS_LOG_LEVEL=DEBUG

# ── BSC 链 ──
# 注意：合约部署在测试网，请使用测试网 RPC
BSC_RPC=https://bsc-testnet-dataseed.bnbchain.org
BSC_CHAIN_ID=97          # BSC Testnet=97, Mainnet=56

# ── 合约地址 ──
# ESCROW_CONTRACT_ADDRESS=                     # ServiceEscrow 合约地址
# DEPOSIT_POOL_ADDRESS=                        # 押金池地址

# ── Agent 私钥 (生产环境必须) ──
# WALLET_KEY_TIEDAN=    # 铁蛋 Agent 私钥
# WALLET_KEY_CHOUDAN=   # 臭蛋 Agent 私钥
# WALLET_KEY_LUDAN=     # 绿蛋 Agent 私钥
# WALLET_KEY_FOUR_MEME= # Four.meme Agent 私钥
