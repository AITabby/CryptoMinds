CRYPTOMINDS_DEBUG=false
CRYPTOMINDS_LOG_LEVEL=INFO
CRYPTOMINDS_LOG_JSON=true
CRYPTOMINDS_INTERNAL_TOKEN=
CRYPTOMINDS_API_PORT=3458
DEMO_MODE=false

BSC_RPC=https://bsc-testnet-dataseed.bnbchain.org
BSC_CHAIN_ID=97
ESCROW_CONTRACT_ADDRESS=
POSTGRES_PASSWORD=
DEPOSIT_POOL_ADDRESS=

