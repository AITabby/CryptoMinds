# CryptoMinds 生产环境配置
# 由 env_loader.py 按 CRYPTOMINDS_ENV=prod 自动加载
# ⚠️ 此文件包含敏感信息，已被 .gitignore 排除，不要提交到 git

CRYPTOMINDS_ENV=prod
CRYPTOMINDS_DEBUG=false
CRYPTOMINDS_LOG_LEVEL=WARNING
CRYPTOMINDS_LOG_JSON=true
CRYPTOMINDS_INTERNAL_TOKEN=<generate-with-openssl-rand-hex-32>
CRYPTOMINDS_API_PORT=3458
DEMO_MODE=false

BSC_RPC=https://bsc-dataseed1.binance.org/
BSC_CHAIN_ID=56
ESCROW_CONTRACT_ADDRESS=0x1A81a18dFC26676AC30f95f4659Fe4c0b4355EC3
ESCROW_V2_CONTRACT_ADDRESS=
ADMIN_SECRET=<generate-with-openssl-rand-hex-32>
ADMIN_PRIVATE_KEY=
ARBITER_WALLETS=
WATCHDOG_INTERVAL=60

# ── Wallet keys (env var 优先于 wallets.json) ──
# WALLET_KEY_GANGDAN=
# WALLET_KEY_TIEDAN=
# WALLET_KEY_CHOUDAN=
# WALLET_KEY_PIDAN=
# WALLET_KEY_LUDAN=
# WALLET_KEY_FOUR_MEME=
